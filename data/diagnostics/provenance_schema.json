{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucanlab.org/schemas/provenance.json",
  "title": "UCanLab Diagnostic Provenance Record Schema",
  "description": "Formal JSON Schema for diagnostic evidence provenance (ISO 26262 ASIL-B / AUTOSAR Dem R25-11 / Konsolide Keşif Raporu F.2).",
  "type": "object",
  "required": [
    "provenance_id",
    "target",
    "activity",
    "agent",
    "source",
    "confidence"
  ],
  "properties": {
    "provenance_id": {
      "type": "string",
      "pattern": "^prv-[a-zA-Z0-9_-]+$",
      "description": "Unique provenance identifier (e.g., prv-0001, prv-p0101-source)."
    },
    "target": {
      "type": "object",
      "required": ["record_id", "field"],
      "properties": {
        "record_id": {
          "type": "string",
          "description": "Target record identifier (DTC code, SPN ID, or DID hex)."
        },
        "field": {
          "type": "string",
          "description": "Target field path (e.g. 'title', 'description.en', 'causes')."
        },
        "xpath": {
          "type": "string",
          "description": "Optional XPath or JSONPath pointer (e.g. '/records/42/description/en')."
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "string",
      "description": "Activity performing data extraction/normalization (e.g. 'normalize_from_source', 'oem_import')."
    },
    "activity_version": {
      "type": "string",
      "description": "Version of the extraction or transformation rule/tool."
    },
    "activity_started": {
      "type": "string",
      "description": "ISO 8601 timestamp of activity commencement."
    },
    "activity_input_hash": {
      "type": "string",
      "description": "Hash of input source artifact (e.g. 'sha256:...')."
    },
    "agent": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["human", "system", "automated", "curator", "organization"],
          "description": "Agent category."
        },
        "id": {
          "type": "string",
          "description": "Agent identifier."
        },
        "role": {
          "type": "string",
          "description": "Agent role (e.g. 'author', 'auditor', 'harvester')."
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["title", "path"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Source title or designation."
        },
        "path": {
          "type": "string",
          "description": "Source URL, DOI, or internal repository reference."
        },
        "type": {
          "type": "string",
          "enum": [
            "standard",
            "oem_manual",
            "nhtsa",
            "academic",
            "web",
            "regulatory",
            "service_bulletin",
            "proprietary",
            "internal_kb"
          ],
          "description": "Source category."
        },
        "publisher": {
          "type": "string",
          "description": "Issuing organization or publisher."
        },
        "revision": {
          "type": "string",
          "description": "Document edition or revision date."
        },
        "licence": {
          "type": "string",
          "description": "Licensing regime."
        },
        "access_date": {
          "type": "string",
          "description": "ISO 8601 access date."
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "archive_url": { "type": "string" },
            "sha256": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 0 },
            "pages_cited": {
              "type": "array",
              "items": { "type": "integer" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["page", "cell", "row", "section", "jsonpath", "xpath", "paragraph", "table", "url"],
          "description": "Locator type within source artifact."
        },
        "value": {
          "type": "string",
          "description": "Locator value or address."
        }
      },
      "additionalProperties": false
    },
    "verbatim": {
      "type": "string",
      "description": "Exact text as extracted from source."
    },
    "transform": {
      "oneOf": [
        { "type": "string", "enum": ["none"] },
        {
          "type": "object",
          "required": ["rule_id"],
          "properties": {
            "rule_id": { "type": "string" },
            "rule_hash": { "type": "string" }
          },
          "additionalProperties": false
        }
      ],
      "description": "Transformation applied to raw source text."
    },
    "confidence": {
      "type": "string",
      "enum": ["operator_verified", "single_source", "corroborated", "unverified"],
      "description": "Confidence level."
    },
    "corroboration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provenance_id", "agreement"],
        "properties": {
          "provenance_id": { "type": "string" },
          "agreement": {
            "type": "string",
            "enum": ["verbatim", "semantic", "conflict"]
          }
        },
        "additionalProperties": false
      },
      "description": "Cross-verifying provenance records."
    },
    "retrieved_from_web": {
      "type": "boolean",
      "description": "Whether source was retrieved via network."
    },
    "http_last_modified": {
      "type": "string",
      "description": "HTTP Last-Modified header value."
    },
    "http_etag": {
      "type": "string",
      "description": "HTTP ETag header value."
    }
  },
  "additionalProperties": false
}
